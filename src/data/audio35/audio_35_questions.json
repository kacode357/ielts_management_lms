    },
    {
      "id": 20,
      "speaker": "Liaison",
      "text": [
        { "type": "text", "value": "Yes. I'm sure you're right. " },
        { "type": "blank", "id": "audio35_q20" },
        { "type": "text", "value": " I'd like you two " },
        { "type": "blank", "id": "audio35_q21" },
        { "type": "text", "value": " is encouraging and improving the students' work ethic." }
