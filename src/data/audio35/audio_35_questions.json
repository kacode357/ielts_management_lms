    {
      "id": 1,
      "speaker": "Liaison",
      "text": [
        { "type": "text", "value": "Come in and sit down, Lester... Sharon. I can see " },
        { "type": "blank", "id": "audio35_q1" },
        { "type": "text", "value": " To start with, I'd just like to say that we " },
        { "type": "blank", "id": "audio35_q2" },
        { "type": "text", "value": " and recognise their importance and assistance " },
        { "type": "blank", "id": "audio35_q3" }
      ]
    },
    {
      "id": 2,
      "speaker": "Lester",
      "text": [
        { "type": "text", "value": "Thank you ... we're looking forward to helping out, but what exactly can we do?" }
      ]
    },
    {
      "id": 3,
      "speaker": "Liaison",
      "text": [
        { "type": "text", "value": "Volunteers can " },
        { "type": "blank", "id": "audio35_q4" },
