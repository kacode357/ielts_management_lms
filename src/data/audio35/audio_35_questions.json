      "id": 36,
      "speaker": "Liaison",
      "text": [
        { "type": "text", "value": "Mmm ...wait till you see their Independent Learning Centre." }
      ]
    },
    {
      "id": 37,
      "speaker": "Lester",
      "text": [
        { "type": "text", "value": "What's so special about their ILC?" }
      ]
    },
    {
      "id": 38,
      "speaker": "Liaison",
      "text": [
        { "type": "text", "value": "They have the most " },
        { "type": "blank", "id": "audio35_q40" },
        { "type": "text", "value": " I've ever seen in this region of the country." }
      ]
    },
    {
      "id": 39,
      "speaker": "Lester",
      "text": [
        { "type": "text", "value": "Really?" }
      ]
    },
    {
      "id": 40,
      "speaker": "Liaison",
      "text": [
        { "type": "text", "value": "Ah huh. And there's a wide number of " },
        { "type": "blank", "id": "audio35_q41" },
        { "type": "text", "value": ", an extensive sporting programme..." }
      ]
    },
