        { "type": "blank", "id": "audio35_q5" }
      ]
    },
    {
      "id": 4,
      "speaker": "Sharon",
      "text": [
        { "type": "text", "value": "Yes, but...what would we do " },
        { "type": "blank", "id": "audio35_q6" },
        { "type": "text", "value": "?" }
      ]
    },
    {
      "id": 5,
      "speaker": "Liaison",
      "text": [
        { "type": "text", "value": "Oh, a variety of tasks, " },
        { "type": "blank", "id": "audio35_q7" },
